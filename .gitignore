# --- 核心修改部分 ---

# 1. 基础忽略项
data/
tmp/
checkpoints/
*.pyc

# 2. 允许 Git 进入 tools/data 但忽略其内容（除非有特定排除）
!tools/data/

# 3. work_dirs 的精细化控制
# 允许 Git 扫描 work_dirs 目录及其子目录
!work_dirs/

# 排除所有权重文件（无论在哪）
*.pth
*.pkl
*.checkpoint

# 显式禁止上传 work_dirs 下的所有权重，但保留其他（log, py, json）
work_dirs/**/*.pth
work_dirs/**/*.pkl

# --------------------
